<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\BlitzRelay\BlitzRelay.csproj" />
    </ItemGroup>

    <!-- Newfarm is a separate repository, checked out alongside this one. Only the migration tests use it, and only
         from the test project: nothing the relay ships knows newfarm exists, and nothing in newfarm knows about the
         relay either. -->
    <ItemGroup>
        <ProjectReference Include="..\..\..\..\Newfarm\Newfarm.Client\Newfarm.Client.csproj" />
        <ProjectReference Include="..\..\..\..\Newfarm\Newfarm.Server\Newfarm.Server.csproj" />
    </ItemGroup>

    <!-- The engine and its relay integration, also checked out beside this repository. Referenced so the transport can be
         driven against a real relay, which is the only place both halves exist at once. -->
    <ItemGroup>
        <ProjectReference Include="..\..\..\..\Nucleus\Nucleus\Nucleus.csproj" Aliases="nucleus" />
        <ProjectReference Include="..\..\..\..\Nucleus\Nucleus.Integrations.BlitzRelay\Nucleus.Integrations.BlitzRelay.csproj" Aliases="nucleus" />
        <!-- The relay compiles the protocol sources into itself, so those types exist in both assemblies and the integration
             brings the second one in behind it. Aliased so the plain names keep meaning the relay's own copy, as they did
             before this project ever saw the integration. -->
        <ProjectReference Include="..\..\src\BlitzRelay.Protocol\BlitzRelay.Protocol.csproj" Aliases="protocol" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

</Project>
