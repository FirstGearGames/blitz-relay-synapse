<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\BlitzRelay\BlitzRelay.csproj" />
    </ItemGroup>

    <!-- Newfarm is a separate repository, checked out alongside this one. Only the migration tests use it, and only
         from the test project: nothing the relay ships knows newfarm exists, and nothing in newfarm knows about the
         relay either. -->
    <ItemGroup>
        <ProjectReference Include="..\..\..\..\Newfarm\Newfarm\Newfarm.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

</Project>
